{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "ios-capability",
  "platforms": ["iOS"],
  "windows": ["main"],
  "permissions": [
    "auth-session:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$TEMP/**/*" }, { "path": "$APPCACHE/**/*" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$TEMP/**/*" }, { "path": "$APPCACHE/**/*" }]
    }
  ]
}
