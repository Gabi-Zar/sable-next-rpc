{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommitTypeAll(chore)',
    ':gitSignOff',
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Europe/Paris',
  schedule: ['* 0-3 * * 1'],
  labels: ['dependencies'],
  minimumReleaseAge: '7 days',
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
    {
      matchManagers: ['npm'],
      groupName: 'npm',
    },
    {
      matchManagers: ['cargo', 'rust-toolchain'],
      groupName: 'cargo',
    },
    {
      description: 'Tauri and its plugins move together',
      matchPackageNames: ['/^tauri(?:-.*)?$/', '/^@tauri-apps\\//'],
      groupName: 'tauri',
    },
    {
      matchManagers: ['terraform'],
      groupName: 'terraform',
    },
    {
      matchManagers: ['mise'],
      groupName: 'mise',
    },
    {
      matchManagers: ['dockerfile'],
      groupName: 'docker',
    },
    {
      matchDatasources: ['git-refs'],
      matchPackageNames: [
        'https://github.com/matrix-org/matrix-rust-sdk{,.git}',
        'https://github.com/ruma/ruma{,.git}',
      ],
      groupName: 'matrix-rust-sdk',
    },
    {
      matchDatasources: ['git-refs'],
      matchPackageNames: ['https://github.com/SableClient/**'],
      enabled: false,
    },
    {
      matchManagers: ['gradle', 'gradle-wrapper'],
      enabled: false,
    },
    {
      description: 'SvelteKit and typescript-eslint still require the TypeScript 6 API',
      matchManagers: ['npm'],
      matchPackageNames: ['typescript'],
      allowedVersions: '<7',
    },
    {
      description: 'CEF and winit must match the pinned tauri-runtime-cef revision',
      matchManagers: ['cargo'],
      matchPackageNames: ['cef', 'winit'],
      enabled: false,
    },
    {
      description: 'GTK must match the version used by WebKitGTK and Tauri',
      matchManagers: ['cargo'],
      matchPackageNames: ['gtk'],
      allowedVersions: '<0.19',
    },
    {
      description: 'The release runner has PipeWire headers for the 0.9 bindings',
      matchManagers: ['cargo'],
      matchPackageNames: ['pipewire'],
      allowedVersions: '<0.10',
    },
  ],
}
