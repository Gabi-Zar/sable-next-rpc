{
  "extends": "$app/tsconfig",
  "include": [
    ".svelte-kit/types/**/$types.d.ts",
    ".storybook/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "oxfmt.config.ts",
    "i18next.config.ts",
    "tests/**/*.ts",
    "src/app.d.ts",
    "src/**/*.svelte",
    "src/**/*.ts"
  ],
  "exclude": [
    "src/service-worker",
    "src/**/*.browser.test.ts",
    "tests/e2e/fixtures/*.browser.test.ts",
    "tests/vitest-browser-setup.ts"
  ]
}
